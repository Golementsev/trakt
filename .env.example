# Скопируйте в .env (он в .gitignore) — доска прочитает его при старте.

# AI-функции доски («✦ Разбить с AI», идеи из «+»). Если ключа нет, используется
# установленный и авторизованный Claude Code (`claude`), иначе AI выключен.
ANTHROPIC_API_KEY=

# Явный выбор источника модели: api | cli | off
# TRAKT_AI=
# Модель для API (по умолчанию claude-opus-5)
# TRAKT_AI_MODEL=
# Команда CLI для режима cli (по умолчанию claude)
# TRAKT_AI_CLI=

# TRAKT_PORT=4700
# TRAKT_DB=data/trakt.db
